# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# metadata route shims the build writes back into src/app; regenerated every
# `next build`, so tracking them just produces churn.
*--route-entry.js
*--metadata.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and is the only record of which keys
# the SMTP demo route needs, so it has to stay tracked.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# brand pipeline: fetched typefaces are ~3MB and reproducible via
# `python scripts/brand/fetch_fonts.py`, so they stay out of the repo.
scripts/brand/fonts/
__pycache__/
