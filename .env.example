# ─────────────────────────────────────────────────────────────
# LogixLoops — environment template
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────

# ── SMTP (Gmail) ──
# Powers /api/notify, which the signature demos on /services/[slug] use to send
# a real email to the visitor (workflow receipt, design export, phone preview).
#
# Requires a Google account with 2-Step Verification enabled, then an App
# Password generated at https://myaccount.google.com/apppasswords.
# Use the 16-character app password — NOT the account password.
SMTP_USER=you@yourdomain.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Display name + address the demo mail is sent as. Gmail rewrites the envelope
# sender to SMTP_USER regardless, so this must match SMTP_USER (or be one of its
# verified "Send mail as" aliases) or Gmail will silently replace it.
SMTP_FROM="LogixLoops <you@yourdomain.com>"

# Optional: address that receives a bcc of every demo send, so you can see what
# visitors are triggering. Leave blank to disable.
SMTP_AUDIT_BCC=

# Optional: hard ceiling on demo emails per hour across the whole deployment.
# Gmail app passwords cap around 500/day; this keeps us far under it.
DEMO_MAIL_HOURLY_CAP=40
